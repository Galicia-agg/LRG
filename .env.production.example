APP_NAME="Lubricantes y Motorepuestos Galicia"
APP_ENV=production
# Generate with: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Real domain over https once DNS/TLS are set up
APP_URL=http://localhost:8090

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=aceitera
DB_USERNAME=aceitera
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true once served over https
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
